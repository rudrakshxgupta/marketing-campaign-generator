# Copy to .env and edit. Everything below has a working default, so the app
# boots and the whole pipeline runs on a clean checkout with no Azure account.
#
# .env is read at startup and deliberately NOT read under pytest: this file
# names a billed deployment, and a test run must not be able to spend anything.

# --- mode --------------------------------------------------------------------
# On by default: images are deterministic placeholders and no Foundry call is
# made. Every other stage -- brief, copy, typesetting, compositing, review,
# export -- runs for real, so the system is fully evaluable offline.
MAI_MOCK=1

# --- Foundry -----------------------------------------------------------------
# https://<resource>.services.ai.azure.com  (no trailing slash)
FOUNDRY_ENDPOINT=

# Leave blank to authenticate with Entra ID via DefaultAzureCredential, i.e.
# your `az login`. Prefer that: there is then no key to leak or rotate.
FOUNDRY_API_KEY=

# --- image model -------------------------------------------------------------
# "flux" or "mai". Both implement the same interface and nothing downstream
# knows which is in use. FLUX is the default here only because every Microsoft
# image model reports a quota of 0 on an Azure for Students subscription.
IMAGE_BACKEND=flux

# The deployment must be named after the MODEL ID, not the URL path: the
# service resolves flux-2-pro back to FLUX.2-pro and looks for that name.
FLUX_MODEL=FLUX.2-pro
FLUX_DRAFT_MODEL=FLUX.2-pro
FLUX_RPM=4

# Used when IMAGE_BACKEND=mai. Deployment names, not model names.
MAI_IMAGE_DEPLOYMENT=mai-image-26
MAI_DRAFT_DEPLOYMENT=mai-image-26-flash
# MAI Global Standard allows 2-12 RPM by tier. Default to the safest.
MAI_RPM=2

# --- text model --------------------------------------------------------------
# Separate deployment with its own quota. Text is measured in hundreds of
# thousands of tokens and images in requests per minute, so a burst of copy
# must never starve an image render.
MAI_TEXT_DEPLOYMENT=gpt-5-mini

# --- spend -------------------------------------------------------------------
# Hard ceilings, enforced BEFORE the call and persisted to disk so they survive
# a restart. Re-read from this file on every call, so raising a cap mid-session
# does not need the server restarted.
#
# Deliberately conservative: it is easier to raise a limit you hit than to
# un-spend a credit.
MAI_DAILY_LIMIT=20
MAI_TOTAL_LIMIT=30

# Serve byte-identical repeat requests from disk. Users re-click Generate
# constantly; without this, each click is a fresh charge.
MAI_CACHE=1
