# Off by default. Set to 0 only once a Foundry deployment exists.
MAI_MOCK=1

# https://<resource>.services.ai.azure.com  (no trailing slash)
FOUNDRY_ENDPOINT=

# Leave blank to authenticate with Entra ID via DefaultAzureCredential.
# Prefer that: there is then no key to leak or rotate.
FOUNDRY_API_KEY=

# Deployment names, not model names.
MAI_IMAGE_DEPLOYMENT=mai-image-26
MAI_DRAFT_DEPLOYMENT=mai-image-26-flash

# MAI Global Standard allows 2-12 RPM by tier. Default to the safest.
MAI_RPM=2
